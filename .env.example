# ============================================================================
# Tulane University Faculty Onboarding Assistant - Environment Configuration
# ============================================================================
# Copy this file to `.env` in the project root (`Copy-Item .env.example .env`)
# and fill in your actual values. Never commit `.env` to version control.

# 1. Google Gemini API Key (Required for `backend/chat_demo.py`)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Gemini Text-Generation Model ID (Required for `backend/chat_demo.py`)
# Set this to a text-generation model available to your Google AI Studio account.
# You can list models available to your key with:
#   .\.venv\Scripts\python -c "import os; from dotenv import load_dotenv; from google import genai; load_dotenv(); c = genai.Client(api_key=os.environ['GEMINI_API_KEY']); print('\n'.join(m.name for m in c.models.list()))"
# Common examples (verify availability in your account): gemini-3.5-flash-lite, gemini-3.8-flash
GEMINI_MODEL=your_available_gemini_model_id_here

# 3. Optional Request Timeout & Retry Settings
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
